<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mod Browser (Modrinth)"
        android:textSize="20sp"
        android:textColor="#e94560"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/editSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="Buscar mod..."
            android:textColor="#fff"
            android:textColorHint="#666"
            android:background="#16213e"
            android:padding="10dp"/>

        <Button
            android:id="@+id/btnSearchApi"
            android:layout_width="60dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:text="🔍"
            android:backgroundTint="#e94560"
            android:textColor="#fff"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Spinner
            android:id="@+id/spinnerMcVersion"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="#0f3460"/>

        <Button
            android:id="@+id/btnFabric"
            android:layout_width="70dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:text="Mods"
            android:backgroundTint="#e94560"
            android:textColor="#fff"
            android:textSize="10sp"/>

        <Button
            android:id="@+id/btnForge"
            android:layout_width="80dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:text="Shaders"
            android:backgroundTint="#0f3460"
            android:textColor="#fff"
            android:textSize="10sp"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="#e94560"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMods"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/btnInstallSelected"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="Instalar (0)"
        android:backgroundTint="#e94560"
        android:textColor="#fff"
        android:enabled="false"/>

</LinearLayout>
