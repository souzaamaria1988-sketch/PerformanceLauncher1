<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PerformanceLauncher"
            android:textSize="24sp"
            android:textColor="#e94560"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minecraft Java no Android"
            android:textSize="12sp"
            android:textColor="#666"
            android:layout_marginBottom="20dp"/>

        <!-- Versão -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#16213e"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Versão do Minecraft" android:textColor="#e94560"
                    android:textStyle="bold" android:textSize="13sp"/>
                <Spinner android:id="@+id/spinnerVersion"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="8dp" android:background="#0f3460"/>
                <Button android:id="@+id/btnDownload"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:layout_marginTop="8dp" android:text="Baixar Versão"
                    android:backgroundTint="#e94560" android:textColor="#fff" android:textSize="12sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Preset de Performance -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#16213e"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⚡ Preset de Performance" android:textColor="#e94560"
                    android:textStyle="bold" android:textSize="13sp"/>
                <Spinner android:id="@+id/spinnerPreset"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="8dp" android:background="#0f3460"/>
                <TextView android:id="@+id/textConfigInfo"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="#999"
                    android:textSize="11sp" android:text=""/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Mods -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#16213e"
            app:cardCornerRadius="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📦 Conteúdo" android:textColor="#e94560"
                    android:textStyle="bold" android:textSize="13sp"/>
                <Button android:id="@+id/btnMods"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:layout_marginTop="8dp" android:text="Mods / Shaders / Packs"
                    android:backgroundTint="#0f3460" android:textColor="#fff" android:textSize="12sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Jogar -->
        <Button android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="▶ JOGAR"
            android:textSize="18sp"
            android:backgroundTint="#e94560"
            android:textColor="#fff"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>
